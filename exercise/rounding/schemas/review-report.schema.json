{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4csr.org/schemas/rounding-review-report-v1.json",
  "title": "BR-001 rounding review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "repository",
    "branch",
    "commit_sha",
    "rule",
    "skill",
    "agent",
    "execution",
    "coverage",
    "findings",
    "unresolved_candidates",
    "unchecked_rules"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "branch": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "comparison", "comparison_version"],
      "properties": {
        "id": {"const": "BR-001"},
        "version": {"const": "1.0"},
        "comparison": {"const": "cards::round5"},
        "comparison_version": {"const": "0.9.0"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "rounding-rule-review"},
        "version": {"const": "1.0.0"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "model"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "r_version", "platform"],
      "properties": {
        "started_at": {"type": "string", "minLength": 1},
        "r_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_examined",
        "files",
        "exclusions",
        "catalog_candidates",
        "exploratory_candidates",
        "parse_errors"
      ],
      "properties": {
        "files_examined": {"type": "integer", "minimum": 0},
        "files": {"type": "array", "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "catalog_candidates": {"type": "integer", "minimum": 0},
        "exploratory_candidates": {"type": "integer", "minimum": 0},
        "parse_errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "unresolved_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "unchecked_rules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "contains": {"const": "BR-002"},
      "minContains": 1,
      "allOf": [
        {"contains": {"const": "BR-003"}, "minContains": 1}
      ],
      "items": {"enum": ["BR-002", "BR-003"]}
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "inputs",
        "observed",
        "approved",
        "divergence_count",
        "negative_zero"
      ],
      "properties": {
        "function": {"enum": ["round", "formatC"]},
        "inputs": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "observed": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "approved": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "divergence_count": {"type": "integer", "minimum": 1},
        "negative_zero": {"type": "boolean"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "file",
        "line",
        "expression",
        "affects",
        "discovery_method",
        "required_digits",
        "probe",
        "summary",
        "status"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^BR001-[A-Z0-9-]+$"},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "expression": {"type": "string", "minLength": 1},
        "affects": {"enum": ["display", "row-selection"]},
        "discovery_method": {"enum": ["catalog", "exploratory"]},
        "required_digits": {"type": "integer", "minimum": 0, "maximum": 15},
        "probe": {"$ref": "#/$defs/probe"},
        "summary": {"type": "string", "minLength": 1},
        "status": {"const": "verified"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "expression", "reason"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "expression": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
